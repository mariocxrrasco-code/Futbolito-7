# Configuración de Futbolito 7
DEBUG=True
SECRET_KEY=django-insecure-futbolito7-sprint2-dev-secret-key-iso27034
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos (PostgreSQL 16 en producción/staging, SQLite fallback para CI/dev local rápido)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/futbolito7_db
DATABASE_URL=sqlite:///db.sqlite3

# Configuración SMTP para enviar correos reales a Yopmail / Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
